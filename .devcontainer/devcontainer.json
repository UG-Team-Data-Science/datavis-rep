{
    "name": "DataVis-Rep",
    "dockerComposeFile": "docker-compose.yml",
    "service": "datavis-rep",
    "workspaceFolder": "/workspaces/datavis-rep",
    "remoteUser": "jovyan",
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-toolsai.jupyter",
                "ms-python.python",
                "ms-r.datascience",
                "redhat.java",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg"
            ],
            "settings": {
                "jupyter.jupyterServerType": "local",
                "jupyter.notebookFileRoot": "/workspaces/datavis-rep"
            }
        }
    },
    "portsAttributes": {
        "8888": {
            "label": "Jupyter",
            "onAutoForward": "notify"
        }
    },
    "forwardPorts": [8888],
    "postStartCommand": "echo 'Codespace ready. Jupyter Lab is provided by the datavis-rep service on port 8888.'"
}
